AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY is intentionally not set here. In Codespaces it comes from
# a Codespaces secret and is already present in the shell environment.
# If running locally without Codespaces, export it yourself or add it to
# your local, untracked .env.
